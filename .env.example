# Copy to .env.local for local development. Never commit real values.

# Postgres connection. In production use the Supabase *transaction pooler* string (port 6543).
DATABASE_URL=postgres://dash:dash@localhost:5432/dash

# Studio access (milestone 1). Replaced by Supabase Auth in milestone 2.
STUDIO_PASSWORD=change-me
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=

# Public site URL, used in email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs unsubscribe links (32+ random chars). Keep it separate from SESSION_SECRET and never rotate it
# casually: old emails' unsubscribe links depend on it.
TOKEN_SECRET=

# Email. Without RESEND_API_KEY, development writes emails to EMAIL_LOG_FILE instead of sending.
# Production refuses to send unless RESEND_API_KEY is set (or EMAIL_TRANSPORT=log explicitly).
# RESEND_API_KEY=
# EMAIL_TRANSPORT=log            # or resend
# EMAIL_LOG_FILE=.email-log.jsonl
EMAIL_FROM="Col <letters@yourdomain.com>"   # must be on a domain verified in Resend
OWNER_EMAIL=you@example.com                  # test sends + reply-to
# RESEND_WEBHOOK_SECRET=whsec_...            # from Resend > Webhooks (delivered, bounced, complained)

# Milestone 3: editorial assistant
# ANTHROPIC_API_KEY=
