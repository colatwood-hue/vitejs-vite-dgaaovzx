# ─── Required ──────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, Railway, RDS or local).
DATABASE_URL=postgres://dash:dash@localhost:5432/thedash
# Public base URL, no trailing slash. Used in emails, RSS, canonical URLs.
APP_URL=http://localhost:3000
# 32+ random bytes. Signs nothing secret-bearing in cookies but salts tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# One-time token to create the first studio account at /studio/setup.
# Remove it after the account exists (setup is also disabled once a user exists).
SETUP_TOKEN=

# ─── Email delivery ────────────────────────────────────────────────────────
# "console" (default) records sends as SIMULATED and never emails anyone.
# "resend" sends real email through Resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Resend webhook signing secret (starts with whsec_) for bounce/complaint events.
RESEND_WEBHOOK_SECRET=
# Safety switch: real broadcasts to subscribers are refused unless this is "true".
# Test sends are allowed without it.
ALLOW_BROADCASTS=false

# ─── AI editorial partner (optional — the studio works without it) ─────────
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5
AI_MODEL=

# ─── Transcription (optional) ──────────────────────────────────────────────
# "openai" (Whisper-compatible /v1/audio/transcriptions) or "deepgram". Empty = off.
TRANSCRIPTION_PROVIDER=
OPENAI_API_KEY=
# Optional override, e.g. gpt-4o-transcribe. Defaults to whisper-1.
OPENAI_TRANSCRIPTION_MODEL=
DEEPGRAM_API_KEY=

# ─── File storage (optional) ───────────────────────────────────────────────
# "db" (default) keeps voice notes and images in Postgres.
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# Browsers upload directly with presigned URLs, so the bucket needs CORS for
# PUT from APP_URL (see docs/SETUP.md). Keep the bucket PRIVATE.
STORAGE_PROVIDER=db
S3_BUCKET=
S3_REGION=auto
# e.g. https://<account-id>.r2.cloudflarestorage.com (leave empty for AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Scheduled jobs ────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=
