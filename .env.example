# Copy to .env.local for local development. Never commit real values.

# Postgres connection. In production use the Supabase *transaction pooler* string (port 6543).
DATABASE_URL=postgres://dash:dash@localhost:5432/dash

# Studio access (milestone 1). Replaced by Supabase Auth in milestone 2.
STUDIO_PASSWORD=change-me
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=

# Public site URL, used in email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Milestone 2: email delivery
# RESEND_API_KEY=
# EMAIL_FROM="Col <col@yourdomain.com>"

# Milestone 3: editorial assistant
# ANTHROPIC_API_KEY=
